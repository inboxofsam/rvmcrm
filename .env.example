# RVM CRM Integration - forwards every form submission into the CRM as a
# Lead (Lead Management -> Web Enquiries), alongside the email notification
# below. Get CRM_WEB_FORM_API_KEY from the CRM: Settings -> Global Settings ->
# Integration Settings -> CRM Integrations -> Website Lead Forms -> Generate
# Key. Leave either value unset to skip this and only send the email.
CRM_API_BASE_URL=https://app.rvmcrm.com/api
CRM_WEB_FORM_API_KEY=your-generated-api-key-here

# Email Integration for RVM CRM Forms
# All lead submissions & demo requests will be sent to rvmcrm@gmail.com

INQUIRY_RECIPIENT=rvmcrm@gmail.com

# Gmail SMTP Configuration (Optional: Create an App Password in your Google Account)
# 1. Enable 2-Step Verification in Google Account: https://myaccount.google.com/security
# 2. Go to 'App passwords' and generate an app password for 'RVM CRM'
# 3. Paste your credentials below in .env.local:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=rvmcrm@gmail.com
SMTP_PASS=your-google-app-password-here
